{
  "name": "climanova",
  "version": "1.0.0",
  "description": "ClimaNova — aplicación meteorológica animada para escritorio",
  "main": "electron/main.cjs",
  "author": "ClimaNova",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check app.js && node --check build-version.js && node --check electron/main.cjs && node --check .github/scripts/set-build-version.cjs && node --check .github/scripts/copy-web.cjs && node --check .github/scripts/set-android-version.cjs",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:win:nsis": "electron-builder --win nsis",
    "dist:win:portable": "electron-builder --win portable",
    "build:web": "node .github/scripts/copy-web.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "mx.climanova.desktop",
    "productName": "ClimaNova",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "build-version.js",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "artifactName": "ClimaNova-${version}-Setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "ClimaNova-${version}-Portable-${arch}.${ext}"
    }
  }
}
